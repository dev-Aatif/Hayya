## Local Android release signing configuration template.
# Copy this file to `keystore.properties` (gitignored) and populate your keystore details,
# or set HAYYA_KEYSTORE_FILE, HAYYA_KEYSTORE_PASSWORD, HAYYA_KEY_ALIAS, and HAYYA_KEY_PASSWORD.
storeFile=hayya-release.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
