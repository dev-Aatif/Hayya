<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Exact Alarms & Timers -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- WakeLocks & Boot Triggers -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Full-screen Lockscreen Intents -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Notifications & Feedback -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Foreground Audio Service (Android 14+ / SDK 34+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Battery Optimization Exemption -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application>

        <!-- Exact Alarm Broadcast Receiver -->
        <receiver
            android:name=".system.receivers.PrayerAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.hayya.alarm.ACTION_TRIGGER_PRAYER_ALARM" />
            </intent-filter>
        </receiver>

        <!-- Boot, Time Change, and Timezone Change Receiver -->
        <receiver
            android:name=".system.receivers.SystemClockChangedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Audio Foreground Service for Adhan Playback -->
        <service
            android:name=".system.audio.PrayerAudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Headless / Stub Activity for Lockscreen Fullscreen Intent -->
        <activity
            android:name=".system.ui.PrayerWakeActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:showForAllUsers="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    </application>

</manifest>
