<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Exact Alarms & Timers -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- WakeLocks & Boot Triggers -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Full-screen Lockscreen Intents -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Notifications & Feedback -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Foreground Audio Service (Android 14+ / SDK 34+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Battery Optimization Exemption -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Optional Hardware Sensor Features for Offline Qibla Compass -->
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <!-- Package visibility for OEM battery/autostart management screens (Android 11+) -->
    <queries>
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.powerkeeper" />
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.samsung.android.sm" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.vivo.permissionmanager" />
    </queries>

    <application
        android:name=".HayyaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Main Launcher Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exact Alarm Broadcast Receiver -->
        <receiver
            android:name=".system.receivers.PrayerAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.hayya.alarm.ACTION_TRIGGER_PRAYER_ALARM" />
                <action android:name="dev.hayya.alarm.ACTION_RESTORE_RINGER_MODE" />
                <action android:name="dev.hayya.alarm.ACTION_TRIGGER_SUHOOR_ALARM" />
                <action android:name="dev.hayya.alarm.ACTION_TRIGGER_EID_NOTIFICATION" />
                <action android:name="dev.hayya.alarm.ACTION_TRIGGER_TAHAJJUD_ALARM" />
            </intent-filter>
        </receiver>

        <!-- Boot, Time Change, and Timezone Change Receiver -->
        <receiver
            android:name=".system.receivers.SystemClockChangedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Audio Foreground Service for Adhan Playback -->
        <service
            android:name=".system.audio.PrayerAudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Persistent Pinned Prayer Status Foreground Service (LMK immunity) -->
        <service
            android:name=".system.notifications.PinnedPrayerStatusService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Displays ongoing prayer window countdown in notification shade" />
        </service>

        <!-- Headless / Stub Activity for Lockscreen Fullscreen Intent -->
        <activity
            android:name=".system.ui.PrayerWakeActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:showForAllUsers="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- Glance AppWidget: Compact 2x2 Prayer Widget -->
        <receiver
            android:name=".widget.CompactPrayerWidgetReceiver"
            android:label="@string/widget_compact_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.hayya.widget.ACTION_PRAYER_DATA_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/compact_prayer_widget_info" />
        </receiver>

        <!-- Glance AppWidget: Full 4x2 Timetable Widget -->
        <receiver
            android:name=".widget.FullTimetableWidgetReceiver"
            android:label="@string/widget_timetable_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.hayya.widget.ACTION_PRAYER_DATA_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/full_timetable_widget_info" />
        </receiver>

        <!-- Glance AppWidget: Daily Prayers Widget -->
        <receiver
            android:name=".widget.DailyPrayersWidgetReceiver"
            android:label="@string/widget_daily_prayers_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.hayya.widget.ACTION_PRAYER_DATA_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/daily_prayers_widget_info" />
        </receiver>

        <!-- Glance AppWidget: 4x1 Quick Strip Widget -->
        <receiver
            android:name=".widget.NextPrayerBannerWidgetReceiver"
            android:label="@string/widget_banner_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.hayya.widget.ACTION_PRAYER_DATA_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_prayer_banner_widget_info" />
        </receiver>

        <!-- Glance AppWidget: 3x2 Night & Fasting Widget -->
        <receiver
            android:name=".widget.FastingAndNightWidgetReceiver"
            android:label="@string/widget_night_fasting_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.hayya.widget.ACTION_PRAYER_DATA_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fasting_night_widget_info" />
        </receiver>

        <!-- General Widget Data Sync Receiver -->
        <receiver
            android:name=".widget.PrayerWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.hayya.widget.ACTION_PRAYER_DATA_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
